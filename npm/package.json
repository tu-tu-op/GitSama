{
  "name": "gitsama",
  "version": "0.1.2",
  "description": "Anime reactions for your Git workflow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tu-tu-op/GitSama.git",
    "directory": "npm"
  },
  "homepage": "https://github.com/tu-tu-op/GitSama#readme",
  "bugs": {
    "url": "https://github.com/tu-tu-op/GitSama/issues"
  },
  "keywords": ["git", "cli", "audio", "developer-tools"],
  "preferGlobal": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gitsama": "bin/gitsama.js"
  },
  "files": [
    "bin/gitsama.js",
    "scripts/postinstall.js",
    "scripts/upgrade.js",
    "scripts/preuninstall.js",
    "scripts/release-checksums.js",
    "release-checksums.json"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "preuninstall": "node scripts/preuninstall.js",
    "prepare-release": "node scripts/release-checksums.js",
    "prepublishOnly": "node scripts/release-checksums.js --check",
    "test": "node --test"
  }
}
